# --- make conda available for non-interactive shells (direnv) ---
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate py310

# Load local env first (project-specific)
dotenv_if_exists .env

# Optional fallback: reuse platform env if present (dev convenience)
dotenv_if_exists ../jinsie-ai-agent-platform/.env

# Keep imports stable (if you need it; otherwise you can remove later)
export PYTHONPATH=.
